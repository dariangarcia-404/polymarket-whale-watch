# Copy to .env and edit. Every setting is optional; defaults are shown.

# Detection
WHALE_TRADE_THRESHOLD_USD=5000
NEW_WALLET_AGE_HOURS=72
LONGSHOT_PRICE=0.10
PRE_RESOLUTION_HOURS=48
QUIET_HOURS_UTC=[5,10]
MARKET_FILTER=events          # "events" skips sports and crypto price markets; "all" keeps them
POLL_INTERVAL_SECONDS=30
DATABASE_URL=sqlite+aiosqlite:///whalewatch.db

# Which severities go to SMS, email and Pushover (desktop gets everything)
NOTIFY_SEVERITIES=["HIGH","CRITICAL"]
ENABLE_DESKTOP_NOTIFICATIONS=true

# SMS via Twilio (pip install 'polymarket-whale-watch[sms]')
ENABLE_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Email via SMTP (pip install 'polymarket-whale-watch[email]'). For Gmail, use an app password.
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_TO=

# Pushover
ENABLE_PUSHOVER=false
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=
