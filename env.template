# ============================================
# POLYMARKET WHALE DETECTOR - CONFIGURATION
# ============================================
# Copy this file to .env and fill in your values
# cp env.template .env

# Detection Settings
WHALE_TRADE_THRESHOLD_USD=5000
NEW_WALLET_AGE_HOURS=72
POLL_INTERVAL_SECONDS=30

# ============================================
# PHONE NOTIFICATIONS - Choose one or more:
# ============================================

# -------- OPTION 1: SMS via Twilio --------
# Sign up at https://www.twilio.com (free trial gives $15 credit)
# Get your credentials from: https://console.twilio.com
ENABLE_SMS=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890  # Your Twilio number
TWILIO_TO_NUMBER=+1234567890    # Your personal phone number

# -------- OPTION 2: Email via Gmail --------
# Use an App Password (NOT your regular password)
# Create one at: https://myaccount.google.com/apppasswords
ENABLE_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx  # 16-char app password
EMAIL_TO=your.email@gmail.com       # Where to send alerts

# -------- OPTION 3: Pushover (Push Notifications) --------
# Best for instant phone notifications
# Download app: iOS/Android ($5 one-time)
# Get keys at: https://pushover.net
ENABLE_PUSHOVER=true
PUSHOVER_USER_KEY=uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUSHOVER_API_TOKEN=axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# NOTIFICATION SETTINGS
# ============================================
# Only send phone notifications for HIGH and CRITICAL alerts
# (to avoid spamming your phone)
PHONE_NOTIFY_SEVERITIES=["HIGH", "CRITICAL"]

# Desktop notifications (for when you're at the Mac mini)
ENABLE_DESKTOP_NOTIFICATIONS=true
ENABLE_SOUND_ALERTS=true

